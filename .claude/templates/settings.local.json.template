{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git checkout*)",
      "Bash(git branch*)",
      "Bash(npm run*)",
      "Bash(npm test*)",
      "Bash(npx *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(mkdir *)"
    ],
    "deny": []
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": ".claude/hooks/workflow-guide.sh \"$PROMPT\"",
        "timeout": 10000
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": ".claude/hooks/pre-implementation.sh \"$TOOL_NAME\" \"$TOOL_INPUT\"",
        "timeout": 10000
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": ".claude/hooks/format-code.sh \"$TOOL_NAME\" \"$TOOL_INPUT\"",
        "timeout": 15000
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": ".claude/hooks/verify-on-stop.sh",
        "timeout": 30000
      }
    ],
    "SubagentStop": [
      {
        "type": "command",
        "command": ".claude/hooks/verify-subagent.sh \"$SUBAGENT_TYPE\" \"$SUBAGENT_OUTPUT\"",
        "timeout": 15000
      }
    ]
  }
}
